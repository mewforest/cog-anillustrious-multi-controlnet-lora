# Copy this file to .env and fill in values as needed. .env is gitignored --
# put anything machine-specific (a local proxy, a different endpoint) there,
# never in a tracked file.

# Proxy auth token for the endpoint (REQUIRED -- the endpoint is deployed
# with requires_proxy_auth=True). Create a pair at
# https://modal.com/settings -> Proxy Auth Tokens. The endpoint URL is NOT a
# secret and is committed in this repo; these two values are.
MODAL_KEY=
MODAL_SECRET=

# Override only if the deployed endpoint URL differs from the default in
# _client.py (e.g. you redeployed under a different workspace/app name).
# MODAL_PREDICT_URL=https://<workspace>--<app>-<class>-<method>.modal.run

# If your network needs a proxy to reach *.modal.run (VPN split-tunneling,
# a corporate firewall, etc.), point this at it. Leave unset or empty to
# connect directly.
# MODAL_PROXY=http://127.0.0.1:8080
