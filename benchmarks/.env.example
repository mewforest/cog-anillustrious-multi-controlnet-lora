# Copy this file to .env and fill in values. .env is gitignored -- put
# secrets and machine-specific values here, never in a tracked file.

# --- Modal ---
# Proxy auth token for the endpoint (REQUIRED -- the endpoint is deployed
# with requires_proxy_auth=True). Create a pair at
# https://modal.com/settings -> Proxy Auth Tokens. The endpoint URL is NOT a
# secret and is committed in this repo; these two values are.
MODAL_KEY=
MODAL_SECRET=

# Override only if the deployed endpoint URL differs from the default
# hardcoded in common.py (e.g. redeployed under a different workspace/app).
# MODAL_PREDICT_URL=https://<workspace>--<app>-<class>-<method>.modal.run

# Reaching *.modal.run needs a proxy on this network (VPN split-tunneling /
# firewall). Leave unset or empty to connect directly.
MODAL_PROXY=http://127.0.0.1:10808

# --- Replicate ---
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# owner/model-name of the pushed Cog model, e.g. mew-forest/anillustrious-multi-controlnet-lora
REPLICATE_MODEL=

# --- Civitai ---
# https://civitai.com/user/account -> API Keys. Appended as ?token=... to
# civitai.com/api/download/models/<version_id> URLs for LoRA downloads that
# need auth (unauthenticated requests get redirected to a login page).
CIVITAI_TOKEN=
